USE_TURSO=false
WNBA_DATA_DIR=/data
WNBA_DB_PATH=/data/wnba.sqlite
WNBA_CACHE_DIR=/data/cache
WNBA_SNAPSHOT_DIR=/data/snapshots
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_database_token
ODDS_API_KEY=your_odds_api_key
SPORTSDATAIO_API_KEY=your_sportsdataio_api_key
ODDSPAPI_KEY=your_oddspapi_key
BALLDONTLIE_API_KEY=your_ball_dont_lie_api_key
ENV=dev
API_KEY=replace_with_shared_api_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_admin_password
VITE_API_KEY=
EXPOSE_DEBUG_HEADERS=false
RATE_LIMIT_MUTATION_CAPACITY=10
RATE_LIMIT_MUTATION_REFILL_PER_SEC=0.5
RATE_LIMIT_REFRESH_CAPACITY=6
RATE_LIMIT_REFRESH_REFILL_PER_SEC=0.33
FRONTEND_PORT=8081
BACKEND_PORT_INTERNAL=8010
WNBA_DOCKER_VOLUME_NAME=wnbastats_wnba_data
