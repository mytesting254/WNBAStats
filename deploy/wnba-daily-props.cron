# Install with:
#   crontab deploy/wnba-daily-props.cron
#
# Adjust the checkout path if needed. Debian/Ubuntu cron does not support
# CRON_TZ for scheduling, so these hourly entries guard on Eastern time with
# date(1). Percent signs must stay escaped in crontab commands.
#
# This runs inside the detected backend container, so API_KEY, ODDS_API_KEY,
# and the live runtime DB/cache paths come from the Coolify container
# environment. The 2am ET flow refreshes ESPN finals/box scores, then refreshes
# cached ESPN rosters so current assignments win over completed-game history.
# It then prunes unsettled Specials rows that are missing from ESPN or marked
# DNP, settles props, and waits for core model training to finish. DFS prewarm
# now runs as a standalone cron after the main training path. Odds import runs
# after DFS so the heavier jobs do not overlap.

0 * * * * cd /root/WNBAStats && [ "$(TZ=America/New_York date +\%H)" = 02 ] && WNBA_USE_LIVE_CONTAINER=true scripts/live_daily_props.sh settle-and-train >> /var/log/wnba-daily-props.log 2>&1
0 * * * * cd /root/WNBAStats && [ "$(TZ=America/New_York date +\%H)" = 03 ] && WNBA_USE_LIVE_CONTAINER=true scripts/live_daily_props.sh train-dfs >> /var/log/wnba-daily-props.log 2>&1
0 * * * * cd /root/WNBAStats && [ "$(TZ=America/New_York date +\%H)" = 04 ] && WNBA_USE_LIVE_CONTAINER=true scripts/live_daily_props.sh odds-if-matchups >> /var/log/wnba-daily-props.log 2>&1
