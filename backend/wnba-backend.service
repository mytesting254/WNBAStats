[Unit]
Description=WNBA Prop Value Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/app-src/backend
EnvironmentFile=/root/app-src/backend/.env.prod
ExecStart=/root/app-src/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/root/app-src/backend /root/app-src/data

[Install]
WantedBy=multi-user.target
